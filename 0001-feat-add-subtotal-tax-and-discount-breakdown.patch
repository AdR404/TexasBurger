diff --git a/lib/services/discount_code_service.dart b/lib/services/discount_code_service.dart
new file mode 100644
index 0000000..b028085
--- /dev/null
+++ b/lib/services/discount_code_service.dart
@@ -0,0 +1,84 @@
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../models/discount_code.dart';
+
+class DiscountCodeService extends ChangeNotifier {
+  static final DiscountCodeService _instance = DiscountCodeService._internal();
+  factory DiscountCodeService() => _instance;
+  DiscountCodeService._internal();
+
+  static const _storageKey = 'texas_discount_codes';
+  List<DiscountCode> _codes = [];
+  bool _initialized = false;
+
+  List<DiscountCode> get codes => List.unmodifiable(_codes);
+
+  Future<void> init() async {
+    if (_initialized) return;
+    final prefs = await SharedPreferences.getInstance();
+    final stored = prefs.getString(_storageKey);
+    if (stored != null && stored.isNotEmpty) {
+      try {
+        _codes = (jsonDecode(stored) as List<dynamic>)
+            .map((item) => DiscountCode.fromJson(item as Map<String, dynamic>))
+            .toList();
+      } catch (_) {
+        _codes = [];
+      }
+    }
+    _initialized = true;
+    notifyListeners();
+  }
+
+  DiscountCode? findActive(String code) {
+    final normalized = code.trim().toUpperCase();
+    for (final coupon in _codes) {
+      if (coupon.isActive && coupon.code.toUpperCase() == normalized) {
+        return coupon;
+      }
+    }
+    return null;
+  }
+
+  Future<void> save(DiscountCode code) async {
+    final normalized = code.code.trim().toUpperCase();
+    final index = _codes.indexWhere((item) => item.code.toUpperCase() == normalized);
+    final saved = DiscountCode(
+      code: normalized,
+      description: code.description.trim(),
+      kind: code.kind,
+      value: code.value,
+      isActive: code.isActive,
+    );
+    if (index == -1) {
+      _codes.add(saved);
+    } else {
+      _codes[index] = saved;
+    }
+    await _persist();
+  }
+
+  Future<void> setActive(String code, bool isActive) async {
+    final index = _codes.indexWhere((item) => item.code == code);
+    if (index == -1) return;
+    _codes[index] = _codes[index].copyWith(isActive: isActive);
+    await _persist();
+  }
+
+  Future<void> remove(String code) async {
+    _codes.removeWhere((item) => item.code == code);
+    await _persist();
+  }
+
+  Future<void> _persist() async {
+    final prefs = await SharedPreferences.getInstance();
+    await prefs.setString(
+      _storageKey,
+      jsonEncode(_codes.map((item) => item.toJson()).toList()),
+    );
+    notifyListeners();
+  }
+}
