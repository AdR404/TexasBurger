diff --git a/lib/models/discount_code.dart b/lib/models/discount_code.dart
new file mode 100644
index 0000000..2b6fef1
--- /dev/null
+++ b/lib/models/discount_code.dart
@@ -0,0 +1,51 @@
+enum DiscountKind { percentage, fixedAmount }
+
+class DiscountCode {
+  final String code;
+  final String description;
+  final DiscountKind kind;
+  final double value;
+  final bool isActive;
+
+  const DiscountCode({
+    required this.code,
+    required this.description,
+    required this.kind,
+    required this.value,
+    this.isActive = true,
+  });
+
+  double discountFor(double amount) {
+    final discount = kind == DiscountKind.percentage
+        ? amount * value / 100
+        : value;
+    return discount.clamp(0.0, amount).toDouble();
+  }
+
+  Map<String, dynamic> toJson() => {
+        'code': code,
+        'description': description,
+        'kind': kind.name,
+        'value': value,
+        'isActive': isActive,
+      };
+
+  factory DiscountCode.fromJson(Map<String, dynamic> json) => DiscountCode(
+        code: json['code'] as String,
+        description: json['description'] as String? ?? '',
+        kind: DiscountKind.values.firstWhere(
+          (kind) => kind.name == json['kind'],
+          orElse: () => DiscountKind.percentage,
+        ),
+        value: (json['value'] as num).toDouble(),
+        isActive: json['isActive'] as bool? ?? true,
+      );
+
+  DiscountCode copyWith({bool? isActive}) => DiscountCode(
+        code: code,
+        description: description,
+        kind: kind,
+        value: value,
+        isActive: isActive ?? this.isActive,
+      );
+}
